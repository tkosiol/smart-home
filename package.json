{
  "name": "smart-home",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare": "lefthook install && pnpm contracts:build",
    "contracts:build": "pnpm --filter @smart/contracts build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && stylelint --allow-empty-input \"apps/frontend/**/*.{css,scss}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:tz": "TZ=Pacific/Chatham pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "infra:up": "docker compose -f infra/local/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/local/compose.yaml down",
    "infra:test": "sh infra/local/smoke-test.sh",
    "licenses:check": "pnpm licenses list --json -r | node tools/lint-config/licenses/check-licenses.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@smart/lint-config": "workspace:*",
    "eslint": "10.12.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "6.0.3"
  }
}
