#!/bin/sh
# Test double for cp on the Pi: the real cp; STUB_FAIL_CP=1 copies and then fails (a half-finished copy);
# STUB_CP_KILL=1 copies and then kills the calling script with SIGKILL (power loss, kill -9 during the copy).
/bin/cp "$@" || exit $?
[ "${STUB_CP_KILL:-0}" = 1 ] && kill -9 "$PPID"
[ "${STUB_FAIL_CP:-0}" = 1 ] && exit 1
exit 0
