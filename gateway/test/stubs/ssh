#!/bin/sh
# Test double for ssh in the deploy tests: counts the calls and can drop connections, then hands over to the shared
# stub ssh ($STUB_REAL_SSH), which runs the remote command in the sandbox.
#   STUB_SSH_DROP_AFTER_START=<n>: after the call that starts migrate.sh, the next n calls fail like a dead connection
state=${STUB_STATE:?}
for last; do :; done
left=$(cat "$state/ssh_drop_left" 2> /dev/null || echo 0)
if [ "$left" -gt 0 ]; then
  echo $((left - 1)) > "$state/ssh_drop_left"
  exit 255
fi
case "$last" in
  *migrate.sh*) if [ -n "${STUB_SSH_DROP_AFTER_START:-}" ]; then echo "$STUB_SSH_DROP_AFTER_START" > "$state/ssh_drop_left"; fi ;;
esac
exec "${STUB_REAL_SSH:?}" "$@"
