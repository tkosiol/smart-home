#!/bin/sh
# Test double for docker on the Pi (deploy.sh tests). Records every call and keeps the state of the two stacks
# in $STUB_STATE (files old_running and new_running). STUB_* variables inject failures:
#   STUB_FAIL_PULL, STUB_FAIL_NEW_UP, STUB_FAIL_OLD_UP, STUB_FAIL_OLD_STOP = 1
#   STUB_FAIL_NEW_STOP = 1: "compose stop" of the new stack fails and stops nothing;
#   STUB_FAIL_DOCKER_STOP = 1: "docker stop" / "docker rm" of a container by name fail too
#   STUB_Z2M_OFFLINE = 1: bridge/state says offline; STUB_BRIDGE = 0: the bridge is down (default 1)
#   STUB_Z2M_OLD_START = 1: the Z2M container "started long ago" (a retained online may be stale);
#   STUB_Z2M_RESTARTS = 1: the restart count grows with every look (restart loop); STUB_MOSQ_UNHEALTHY = 1
#   STUB_PS_FAIL = <exit code>: the "ps -q" probes of the NEW project (compose and docker ps) fail with that code and
#   no output (124 = a timeout); STUB_OLD_PS_FAIL = <exit code>: the same for "ps -q" of the old stack
#   STUB_OLD_ONLY_MOSQ = 1: only the mosquitto service of the old stack runs; STUB_UP_DELAY = <s>: "up -d" of the
#   new stack takes that long
printf 'docker %s\n' "$*" >> "$STUB_CALLS"
state=${STUB_STATE:?}
case "$*" in
  "compose -f "*)
    # The old stack (its own compose file).
    case "$*" in
      *" config --services"*) printf 'mosquitto\nzigbee2mqtt\n' ;;
      *" ps "*)
        case "$*" in
          *--services*) ;;
          *) [ -n "${STUB_OLD_PS_FAIL:-}" ] && exit "$STUB_OLD_PS_FAIL" ;;
        esac
        if [ -e "$state/old_running" ]; then
          case "$*" in
            *--services*) if [ "${STUB_OLD_ONLY_MOSQ:-0}" = 1 ]; then echo mosquitto; else printf 'mosquitto\nzigbee2mqtt\n'; fi ;;
            *) echo oldcontainer ;;
          esac
        fi ;;
      *" stop"*)
        [ "${STUB_FAIL_OLD_STOP:-0}" = 1 ] && exit 1
        rm -f "$state/old_running" ;;
      *" up -d"*)
        [ "${STUB_FAIL_OLD_UP:-0}" = 1 ] && exit 1
        : > "$state/old_running" ;;
    esac ;;
  "compose --env-file secrets/gateway.env "*)
    case "$*" in
      *" pull"*)
        printf 'pull-profiles COMPOSE_PROFILES=%s\n' "${COMPOSE_PROFILES:-}" >> "$STUB_CALLS"
        [ "${STUB_FAIL_PULL:-0}" = 1 ] && exit 1 ;;
      *" up -d"*)
        [ -n "${STUB_UP_DELAY:-}" ] && sleep "$STUB_UP_DELAY"
        [ "${STUB_FAIL_NEW_UP:-0}" = 1 ] && exit 1
        : > "$state/new_running" ;;
      *" stop"*)
        [ "${STUB_FAIL_NEW_STOP:-0}" = 1 ] && exit 1
        rm -f "$state/new_running" ;;
      *"ps --status running -q zigbee2mqtt"*) if [ -e "$state/new_running" ]; then echo z2mcontainer; fi ;;
      *"ps -q zigbee2mqtt"*) if [ -e "$state/new_running" ]; then echo z2mcontainer; fi ;;
      *"ps -q mosquitto"*) if [ -e "$state/new_running" ]; then echo mosquittocontainer; fi ;;
      *"ps --status running -q"*)
        [ -n "${STUB_PS_FAIL:-}" ] && exit "$STUB_PS_FAIL"
        if [ -e "$state/new_running" ]; then echo z2mcontainer; fi ;;
      *"mosquitto_sub"*"bridge/state"*)
        if [ "${STUB_Z2M_OFFLINE:-0}" = 1 ]; then echo '{"state":"offline"}'; else echo '{"state":"online"}'; fi ;;
      *"mosquitto_sub"*"bridge/connection"*) echo "${STUB_BRIDGE:-1}" ;;
      *" ps"*) printf 'NAME  STATUS\nmosquitto  Up (healthy)\nzigbee2mqtt  Up\n' ;;
    esac ;;
  "inspect -f "*)
    case "$*" in
      *StartedAt*)
        count=0
        if [ "${STUB_Z2M_RESTARTS:-0}" = 1 ]; then
          count=$(($(cat "$state/restarts" 2> /dev/null || echo 0) + 1))
          echo "$count" > "$state/restarts"
        fi
        if [ "${STUB_Z2M_OLD_START:-0}" = 1 ]; then started=2000-01-01T00:00:00.000000000Z; else started=2999-01-01T00:00:00.000000000Z; fi
        echo "true $count $started" ;;
      *RestartCount*) echo 0 ;;
      *Health*) if [ "${STUB_MOSQ_UNHEALTHY:-0}" = 1 ]; then echo unhealthy; else echo healthy; fi ;;
    esac ;;
  "ps "*)
    # docker ps of the new project (by label), running or all (names)
    [ -n "${STUB_PS_FAIL:-}" ] && exit "$STUB_PS_FAIL"
    if [ -e "$state/new_running" ]; then
      case "$*" in
        *--format*) echo smart-gateway-zigbee2mqtt-1 ;;
        *) echo z2mcontainer ;;
      esac
    fi ;;
  "stop "* | "rm "*)
    [ "${STUB_FAIL_DOCKER_STOP:-0}" = 1 ] && exit 1
    rm -f "$state/new_running" ;;
esac
exit 0
