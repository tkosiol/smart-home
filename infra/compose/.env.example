# Written by infra/deploy/provision.sh on the VPS (~/docker/apps/<stack>/.env, mode 600).
# IMAGE_TAG is not set here: deploy.sh writes it to deploy.env for every release.
STACK_NAME=smart-staging
APP_DOMAIN=staging.smart.tillkosiol.de
DB_PASSWORD=<generated>
MQTT_API_PASSWORD=<generated>

# Origin the browser uses (https, no path); the API refuses unsafe requests from any other origin.
APP_ORIGIN=https://staging.smart.tillkosiol.de
# Proxies in front of the api: web nginx (1) plus Nginx Proxy Manager on the VPS (2).
TRUSTED_PROXY_HOPS=2

# Mail for the sign-in codes (Resend over SMTP). Without SMTP_URL the e-mail sign-in is switched off.
SMTP_URL=smtps://resend:<API key>@smtp.resend.com:465
MAIL_FROM=Smart Home <noreply@example.org>
# Staging only: only these recipients receive mail (comma separated).
MAIL_ALLOWLIST=<address>,<address>

# Web app runtime configuration (served as /config.json, see docs/runbooks/provisioning.md).
# Optional instance default theme as JSON, for example:
# SMART_INSTANCE_APPEARANCE={"colors":{"seed":"#6e4c7e","variant":"tonalSpot","colorMatch":false,"coreOverrides":{}},"shape":"standard","font":"roboto-flex"}

# Production only (enables the backup container):
# COMPOSE_PROFILES=backup
# BACKUP_UID=<id -u of the deploy user>
# BACKUP_GID=<id -g of the deploy user>
# B2_ENDPOINT=<B2_S3_ENDPOINT>
# B2_BUCKET=<B2_BUCKET>
# B2_KEY_ID=<from password manager>
# B2_APP_KEY=<from password manager>
# RESTIC_PASSWORD=<from password manager>
# HC_BACKUP_URL=<healthchecks.io ping URL>
# HC_RESTORE_URL=<healthchecks.io ping URL>
