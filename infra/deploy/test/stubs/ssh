#!/bin/sh
# Test double for ssh: "test -e" answers from STUB_ENV_EXISTS; other commands write stdin to STUB_REMOTE_FILE.
printf 'ssh %s\n' "$*" >> "$STUB_CALLS"
case "$*" in
  *"test -e"*)
    if [ "${STUB_ENV_EXISTS:-0}" = 1 ]; then exit 0; else exit 1; fi ;;
  *) cat > "$STUB_REMOTE_FILE" ;;
esac
