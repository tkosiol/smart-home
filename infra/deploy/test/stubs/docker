#!/bin/sh
# Test double: records every call; fails or answers depending on STUB_* variables.
printf '%s\n' "$*" >> "$STUB_CALLS"
# Whether the bind-mounted certificate directories exist at the time of the call (deploy.sh runs in the stack directory).
if [ -d certs/public ] && [ -d certs/private ]; then echo present >> "${STUB_CALLS}.certs"; else echo missing >> "${STUB_CALLS}.certs"; fi
# One line per argument, to prove how arguments arrive (word boundaries survive).
if [ -n "${STUB_ARGV_LOG:-}" ]; then
  printf 'docker' >> "$STUB_ARGV_LOG"
  for argument; do printf ' <%s>' "$argument" >> "$STUB_ARGV_LOG"; done
  printf '\n' >> "$STUB_ARGV_LOG"
fi
case "$*" in
  *"mosquitto_passwd -U"*)
    # Stands in for the mosquitto image: turns every user:password line of the mounted file into user:<hash>
    # in place (-v <host dir>:<container dir>, the last argument is the file in the container).
    [ "${STUB_FAIL_PASSWD:-0}" = 1 ] && exit 1
    # STUB_PASSWD_PLAIN=1: succeeds but leaves the plain text file as it is; STUB_PASSWD_EMPTY=1: leaves it empty.
    [ "${STUB_PASSWD_PLAIN:-0}" = 1 ] && exit 0
    previous=''
    for argument; do
      [ "$previous" = -v ] && mount=$argument
      previous=$argument
      last=$argument
    done
    container_dir=${mount#*:}
    plain="${mount%%:*}${last#"$container_dir"}"
    while IFS=: read -r user password; do
      # shellcheck disable=SC2016 # $7$ is the literal hash prefix
      printf '%s:$7$101$stub$%s\n' "$user" "$(printf '%s' "$password" | cksum | cut -d' ' -f1)"
    done < "$plain" > "$plain.hashed"
    mv "$plain.hashed" "$plain"
    [ "${STUB_PASSWD_EMPTY:-0}" = 1 ] && : > "$plain"
    exit 0 ;;
  *"up -d --wait db broker"*)
    [ "${STUB_FAIL_INFRA:-0}" = 1 ] && exit 1 ;;
  *"run --rm --no-deps api node dist/migrate.js"*)
    [ "${STUB_FAIL_MIGRATE:-0}" = 1 ] && exit 1 ;;
  *"deploy.env.next up -d --wait --remove-orphans"*)
    [ "${STUB_FAIL_UP:-0}" = 1 ] && exit 1 ;;
  *"exec -T web wget"*)
    # STUB_READY_FAILURES: how many readiness probes answer "unavailable" before "ok" (default 0; "all" = never ok)
    count_file="${STUB_CALLS}.ready"
    count=$(cat "$count_file" 2> /dev/null || echo 0)
    echo $((count + 1)) > "$count_file"
    if [ "${STUB_READY_FAILURES:-0}" = all ] || [ "$count" -lt "${STUB_READY_FAILURES:-0}" ]; then
      echo '{"status":"unavailable"}'
    else
      echo '{"status":"ok"}'
    fi ;;
esac
exit 0
