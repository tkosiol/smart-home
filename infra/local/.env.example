# Local development only. Copy to infra/local/.env to override the defaults.
LOCAL_DB_PASSWORD=smart-local-only
LOCAL_MQTT_USER=smart-api
LOCAL_MQTT_PASSWORD=smart-dev-only

# Backend (`pnpm --filter @smart/backend start:dev`): export these in the shell that starts it.
APP_ORIGIN=http://localhost:4200
SMTP_URL=smtp://127.0.0.1:1026
MAIL_FROM="Smart Home <noreply@localhost>"
